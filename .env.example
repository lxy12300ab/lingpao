# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-this-with-a-random-secret-at-least-24-characters
TZ=Asia/Shanghai
# Increment on every release; do not use characters other than letters/numbers/.-_
BUILD=2026.09.20.8
# Run scripts/setup.py first; use `id -u` / `id -g` on your NAS account.
APP_UID=1000
APP_GID=1000
# DSM uses port 5000 itself! Use 5080 as the loopback target.
BIND_IP=127.0.0.1
HTTP_PORT=5080
HTTPS_BIND_IP=127.0.0.1
HTTPS_PORT=8443
ENABLE_SCHEDULER=1
BACKUP_RETENTION_DAYS=90
# Optional existing WebDAV folder; server must accept PUT; remote files are NOT deleted.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
